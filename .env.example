# Environment Configuration for Scadova-AI-India
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Product Information
PRODUCT_NAME=Scadova-AI-India
MODULE_NAME=loan_agency
API_VERSION=1.0.0

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STORAGE_BUCKET=loan-agency-documents

# Database (PostgreSQL / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scadova_india
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scadova_india

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# AI Integration (Optional)
AI_PROVIDER=google
AI_MODEL=gemini-1.5-pro
AI_API_KEY=
